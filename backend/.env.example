# ZKGate India backend configuration. Copy to .env (git-ignored) and adjust.
# Every value has a working default; an empty file runs fine for local dev.
# Never commit real values. In production inject secrets from a secret manager.

# "production" switches every default to the restrictive option: API keys
# required, /docs off, public demo verifiers not seeded, HSTS on.
ENVIRONMENT=development

# Leave empty to use the in-memory nullifier registry (no Redis required).
# In production use TLS: rediss://<user>:<password>@<host>:6380
REDIS_URL=

# Leave empty to use the in-memory audit chain (no Postgres required).
# In production: postgresql+asyncpg://<least-privilege-user>:<password>@<host>:5432/zkgate?ssl=require
DATABASE_URL=

# Where the circuit verification keys and signal_layout.json live.
CIRCUIT_KEYS_DIR=../circuits/keys

# Shared secret for admin-only endpoints (POST /v1/verifiers), sent as
# X-Admin-Token. Generate one with: python -c "import secrets;print(secrets.token_urlsafe(32))"
# Empty => registration is open in development and disabled in production.
ADMIN_TOKEN=

# Optional overrides. Leave unset to get the environment's default.
# REQUIRE_API_KEY=true
# DOCS_ENABLED=false
# SEED_DEMO_VERIFIERS=false
# RATE_LIMIT_REQUESTS=120
# RATE_LIMIT_WINDOW_SECONDS=60
# MAX_BODY_BYTES=1000000
# CORS_ORIGINS=["https://zkgate.net","https://www.zkgate.net"]
