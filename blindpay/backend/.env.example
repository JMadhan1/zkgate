# BlindPay API settings. Copy to .env (git-ignored) for local overrides.
# In production every secret comes from a secret manager at runtime; never commit values.

BLINDPAY_ENVIRONMENT=development
# BLINDPAY_DATABASE_URL=postgresql+psycopg://blindpay_app:<password>@<host>:5432/blindpay?sslmode=require
# BLINDPAY_PUBLIC_BASE_URL=https://app.example.com
# BLINDPAY_ENCRYPTION_KEY=<32 random bytes, base64: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())">
# BLINDPAY_ADMIN_TOKEN=<long random value>

# WhatsApp Cloud API (Meta Business > WhatsApp > API setup)
# BLINDPAY_WHATSAPP_APP_SECRET=
# BLINDPAY_WHATSAPP_VERIFY_TOKEN=
# BLINDPAY_WHATSAPP_ACCESS_TOKEN=
# BLINDPAY_WHATSAPP_PHONE_NUMBER_ID=

# RazorpayX (payouts) and Razorpay (subscriptions)
# BLINDPAY_RAZORPAYX_KEY_ID=
# BLINDPAY_RAZORPAYX_KEY_SECRET=
# BLINDPAY_RAZORPAYX_ACCOUNT_NUMBER=
# BLINDPAY_RAZORPAYX_WEBHOOK_SECRET=
# BLINDPAY_RAZORPAY_WEBHOOK_SECRET=
# BLINDPAY_RAZORPAY_PLAN_TEAM=
# BLINDPAY_RAZORPAY_PLAN_BUSINESS=
