# Copy to .env (git-ignored) and fill in. Never commit real values.

# docker-compose Postgres (local development)
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# Backend (production)
# ENVIRONMENT=production          # turns on API keys, turns off /docs and demo verifiers
# ADMIN_TOKEN=                    # long random value from your secret manager; gates POST /v1/verifiers
# REDIS_URL=rediss://...          # TLS Redis for the nullifier registry
# CORS_ORIGINS=["https://zkgate.net","https://www.zkgate.net"]

# Frontend (public — NEXT_PUBLIC_* values end up in the browser bundle; no secrets here)
# NEXT_PUBLIC_SITE_URL=https://zkgate.net
# NEXT_PUBLIC_API_URL=https://api.zkgate.net
